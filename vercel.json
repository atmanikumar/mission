    },
    {
      "source": "/free-qr-code-generator/icon.png",
      "destination": "https://free-qr-code-generator-app.vercel.app/icon.png"
    },
    {
      "source": "/free-qr-code-generator/favicon.ico",
      "destination": "https://free-qr-code-generator-app.vercel.app/icon.png"
    },
    {
      "source": "/free-qr-code-generator/manifest.json",
      "destination": "https://free-qr-code-generator-app.vercel.app/manifest.json"
    },
    {
      "source": "/free-qr-code-generator/:path*",
      "destination": "https://free-qr-code-generator-app.vercel.app/free-qr-code-generator/:path*"
    },
    {
      "source": "/calculator",
      "destination": "https://calculator-xi-one-56.vercel.app/calculator"
    },
    {
      "source": "/calculator/icon",
      "destination": "https://calculator-xi-one-56.vercel.app/calculator/icon"
    },
    {
      "source": "/calculator/apple-icon",
      "destination": "https://calculator-xi-one-56.vercel.app/calculator/apple-icon"
    },
    {
      "source": "/calculator/favicon.ico",
