{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/thirukkural",
      "destination": "https://tirukkural.vercel.app/"
    },
    {
      "source": "/thirukkural/favicon.ico",
      "destination": "https://tirukkural.vercel.app/favicon.ico"
    },
    {
      "source": "/thirukkural/favicon.png",
      "destination": "https://tirukkural.vercel.app/favicon.png"
    },
    {
      "source": "/thirukkural/:path*",
      "destination": "https://tirukkural.vercel.app/:path*"
    },
    {
      "source": "/free-qr-code-generator",
      "destination": "https://free-qr-code-generator-app.vercel.app/free-qr-code-generator"
    },
    {
